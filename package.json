{
  "name": "opencode-usage-stats",
  "version": "0.1.0",
  "description": "OpenCode v2 用量统计面板插件：在 TUI 中查看 Token 消耗、缓存命中率、费用与模型分布（参考 cc-switch 用量统计）",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "usage",
    "stats"
  ],
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.tsx"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "@opentui/core": ">=0.5.12",
    "@opentui/solid": ">=0.5.12",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/client": "2.0.18",
    "@opencode/plugin": "2.0.18",
    "@opencode/theme": "2.0.18",
    "@opentui/core": "0.5.12",
    "@opentui/solid": "0.5.12",
    "@types/node": "24.12.2",
    "solid-js": "1.9.12",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
